  "evaluations": [
    {
      "id": "thiruparankundram-compliance",
      "title": {
        "en": "Thiruparankundram: the lamp ceremony, compliance and competing frames",
        "hi": "तिरुपरनकुंद्रम: दीप समारोह, अनुपालन और अलग प्रस्तुतियाँ"
      },
      "path": "/blindspots#thiruparankundram-compliance",
      "summary": {
        "en": "Seven examined articles from four publishers discuss the 24 November ceremony and the subsequent compliance dispute. Their accounts describe a lamp lit at the traditional site rather than the disputed pillar. Whether officials committed contempt, and the underlying title and customary-rights questions, are not settled by this comparison. The court orders and affidavits have not been independently audited by INP.",
        "hi": "चार प्रकाशकों के सात जाँचे लेख 24 नवंबर के समारोह और बाद के अनुपालन विवाद पर हैं। उनके अनुसार दीप विवादित स्तंभ के बजाय पारंपरिक स्थान पर जला। अवमानना, स्वामित्व और प्रथागत अधिकारों के प्रश्न इस तुलना से तय नहीं होते। INP ने अदालती आदेशों और शपथपत्रों का स्वतंत्र ऑडिट नहीं किया है।"
      },
      "comparison": [
        {
          "publisherGroup": "organiser",
          "publisher": "Organiser",
          "url": "https://organiser.org/2026/11/26/429162/politics/rss-urges-tamil-nadu-govt-to-respect-peoples-legitimate-wishes-recognised-by-sc-in-thiruparankundram-deepam-issue/",
          "title": "RSS demands Tamil Nadu govt to respect people’s legitimate wishes recognised by SC in Thiruparankundram Deepam issue",
