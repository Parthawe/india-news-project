{
  "name": "INP",
  "version": "1.1.0",
  "tagline": "Understand the news. Compare the coverage.",
  "css": {
    "color-brand": "#e3120b",
    "color-ink": "#121212",
    "color-paper": "#ffffff",
    "color-muted": "#595959",
    "color-rule": "#d9d9d9",
    "color-wash": "#f2f2f2",
    "color-action": "#ffdf00",
    "color-warning": "#75571e",
    "color-success": "#245c50",
    "color-error": "#a52020",
    "color-left": "#1b4b96",
    "color-centre": "#ffffff",
    "color-right": "#a92e48",
    "color-unassessed": "#777777",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "24px",
    "space-6": "32px",
    "space-7": "48px",
    "space-8": "64px",
    "type-display": "clamp(34px, 4vw, 56px)",
    "type-heading": "clamp(26px, 2.5vw, 36px)",
    "type-body": "20px",
    "type-interface": "16px",
    "type-meta": "13px",
    "measure-reading": "68ch",
    "layout-max": "1280px",
    "layout-gutter": "32px",
    "layout-gutter-mobile": "20px",
    "control-height": "44px",
    "radius-control": "2px",
    "focus-width": "3px",
    "focus-offset": "4px",
    "motion-fast": "120ms",
    "motion-standard": "180ms"
  },
  "fonts": {
    "english": {
      "serif": "Source Serif 4",
      "sans": "Source Sans 3",
      "fallbacks": [
        "Georgia",
        "Arial"
      ]
    },
    "hindi": {
      "serif": "Noto Serif Devanagari",
      "sans": "Noto Sans Devanagari"
    },
    "note": "Public exports use bundled licensed fonts. Local reference font names are legacy implementation aliases, not distributed font licences.",
    "regionalFallback": {
      "bn": {
        "serif": "Noto Serif Bengali",
        "sans": "Noto Sans Bengali",
        "scope": "Original source headlines; not a Bengali interface edition."
      }
    }
  },
  "breakpoints": {
    "mobile": 700,
    "readingRail": 1000,
    "feedRail": 1100
  },
  "illustrations": {
    "ratio": "2:1",
    "width": 1200,
    "height": 600,
    "seal": "INP",
    "provenanceRoute": "/method/#illustrations",
    "rule": "Conceptual artwork; never evidence of an event."
  },
  "accessibility": {
    "bodyContrast": 4.5,
    "largeTextContrast": 3,
    "minimumControlHeight": 44,
    "reducedMotion": true,
    "languageSwitchPreservesRoute": true
  },
  "components": [
    "PublicationMark",
    "DesignButton",
    "EditorialStatus",
    "EditorialIllustration",
    "SourceMix",
    "Form fields",
    "Evidence disclosures",
    "Story rows",
    "Reading navigation"
  ],
  "states": [
    "default",
    "hover",
    "keyboard focus",
    "selected",
    "disabled",
    "loading",
    "empty",
    "error",
    "partial extraction",
    "insufficient evidence",
    "success",
    "correction"
  ],
  "editorialRules": [
    "Unknown is not centre.",
    "Publisher leaning and article framing are separate.",
    "Show source timestamps and examined material.",
    "A collected headline is not a reviewed story.",
    "Keep original headlines and identify translations."
  ],
  "fullName": "India News Project",
  "identity": {
    "primaryMark": "INP",
    "expandedName": "India News Project",
    "brandKit": "/brand",
    "conversation": "Ask INP",
    "illustrationSeal": "The publisher mark in the bottom-right of an illustration links to its creation method."
  }
}
